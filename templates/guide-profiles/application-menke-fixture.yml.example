# Guide profile: menke-fixture — retrieval-fixture only (SPIKE-001 T07 mode B)
#
# Copy into guide checkout (gitignored):
#   cp templates/guide-profiles/application-menke-fixture.yml.example \
#      ~/github/jmjava/guide/scripts/user-config/application-menke-fixture.yml
# Or just run: ./scripts/guide/append-retrieval-fixture.sh (rewrites this file).
#
# Why this looks the way it does:
# - append-ingest.sh defaults FORCE_STARTUP_INGEST=1, which sets
#   GUIDE_RELOADCONTENTONSTARTUP=true and runs DataManager.loadReferences().
# - loadReferences() always walks guide.content.versioned + supplementary URLs
#   from application.yml. Setting `urls: []` does NOTHING (urls is computed).
# - So this profile MUST clear content.versioned.versions and supplementary,
#   otherwise every fixture ingest re-embeds the whole Embabel docs + Medium corpus.
#
# Prefer absolute paths for directories (replace ORCHESTRATOR_ROOT below).

guide:
  reload-content-on-startup: false
  content-chunker:
    include-section-title-in-chunk: true
    max-chunk-size: 4000
    overlap-size: 200
    embedding-batch-size: 50
  # Clear default URL corpus so FORCE_STARTUP_INGEST only hits directories.
  content:
    versioned:
      base-url: https://docs.embabel.com/embabel-agent/guide/
      versions: []
    supplementary: []
  spdd-projection:
    enabled: true
    default-root-path: ORCHESTRATOR_ROOT
  directories:
    - ORCHESTRATOR_ROOT/examples/retrieval-fixture
  git-ingestion:
    enabled: true
    state-file: scripts/user-config/ingestion-git-revisions-menke-fixture.json
